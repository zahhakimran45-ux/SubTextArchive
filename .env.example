# =============================================================================
# Subtext environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# Every value below is a safe placeholder — no real secrets are included.
# =============================================================================

# -----------------------------------------------------------------------------
# Data provider
#   "local"    -> SQLite + FTS5 + cookie sessions (default; works with no
#                 external service; data stored under ./data, private to this
#                 deployment). This is the only provider implemented by the
#                 running application in this build.
#   "supabase" -> RESERVED: the SQL migrations and a reference adapter exist in
#                 supabase/, but the runtime Supabase data provider is not yet
#                 implemented. Selecting it makes the app refuse to start with
#                 a clear configuration error instead of silently falling back.
# -----------------------------------------------------------------------------
DATA_PROVIDER=local

# Local provider: database file location (relative paths resolve from project root).
# On serverless platforms (e.g. Vercel) this MUST be set explicitly: the only
# writable directory there is /tmp, and anything stored in /tmp is destroyed
# when the function recycles. Use /tmp/subtext.sqlite only for throwaway
# preview deployments; real deployments need a host with persistent storage.
LOCAL_DATABASE_PATH=./data/subtext.sqlite

# Required in production (NODE_ENV=production): a unique random value of at
# least 32 characters. The built-in development secret and the placeholder
# below are both refused by the production startup check.
# Generate one with: openssl rand -base64 48
LOCAL_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Upload / import safeguards
MAX_IMPORT_BYTES=10485760
MAX_MESSAGES_PER_IMPORT=50000

# -----------------------------------------------------------------------------
# Supabase (forward-looking: consumed once the Supabase runtime provider lands)
# Find these in your Supabase project: Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key: SERVER ONLY. Never prefixed NEXT_PUBLIC, never imported into client code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Supabase Storage bucket used for retained raw export files (private bucket).
SUPABASE_IMPORT_BUCKET=private-imports

# Public URL used for password reset links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional semantic search (disabled unless configured; keyword search always works)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=off
# e.g. "openai" — when enabled, document in the privacy center what data leaves the system
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
