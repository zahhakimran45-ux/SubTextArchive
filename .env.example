# =============================================================================
# Subtext environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` or any real key. Every value below is a safe placeholder.
# =============================================================================

# -----------------------------------------------------------------------------
# Data provider
#   "local"    -> SQLite + FTS5 + cookie sessions (default). Runs the entire
#                 application with no external service; data lives under
#                 LOCAL_DATABASE_PATH, private to this deployment.
#   "supabase" -> Supabase Auth + PostgreSQL (PostgREST) with Row Level
#                 Security. Requires the three SUPABASE_* variables below and
#                 the migrations in supabase/migrations applied to the
#                 project. All application features work identically through
#                 either provider; only the storage/auth backend changes.
# -----------------------------------------------------------------------------
DATA_PROVIDER=local

# -----------------------------------------------------------------------------
# Local provider settings (ignored when DATA_PROVIDER=supabase)
# -----------------------------------------------------------------------------

# Database file location (relative paths resolve from the project root).
# On serverless platforms (e.g. Vercel) the only writable directory is /tmp,
# which is destroyed when the function recycles. Set this explicitly there and
# use DATA_PROVIDER=supabase for persistent data; /tmp is only appropriate for
# throwaway preview deployments.
LOCAL_DATABASE_PATH=./data/subtext.sqlite

# Required in production (NODE_ENV=production) with the local provider: a
# unique random value of at least 32 characters. The built-in development
# secret and the placeholder below are both refused by the startup check.
# Generate one with: openssl rand -base64 48
LOCAL_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Upload / import safeguards (apply to both providers)
MAX_IMPORT_BYTES=10485760
MAX_MESSAGES_PER_IMPORT=50000

# -----------------------------------------------------------------------------
# Supabase provider settings (required when DATA_PROVIDER=supabase)
# Find these in your Supabase project: Project Settings -> API.
# Apply supabase/migrations/0001..0004 in order before deploying the app.
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable anon key. Safe for the browser; RLS policies (not this key) are
# what keep user data isolated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: SERVER ONLY. Never use a NEXT_PUBLIC name, never import it
# into client code, and never put it in middleware or browser bundles. It is
# used solely for account administration (signup, account deletion).
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Private Storage bucket for retained raw export files. Created by
# migration 0003 together with its owner-prefix RLS policies.
SUPABASE_IMPORT_BUCKET=private-imports

# Public canonical URL, used for password-reset redirect links (both providers)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional semantic search (disabled unless configured; keyword/Recall search
# always works without it). When enabled, document in the privacy center what
# data leaves the system.
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=off
# e.g. "openai"
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Test-only knobs (never set in a real deployment)
#   RATE_LIMIT_DISABLED=1 is set automatically by the Playwright config so the
#   e2e suite can register many accounts from one loopback IP without tripping
#   the per-IP rate limiter. It is deliberately undocumented above the line and
#   must never appear in a production environment.
# -----------------------------------------------------------------------------
